      "text": "```python\nimport os\nimport tarfile\n\n\ndef _is_within(base: str, path: str) -> bool:\n    try:\n        return os.path.commonpath([base, path]) == base\n    except ValueError:\n        return False\n\n\ndef extract_tar(archive_path: str, dest_dir: str) -> None:\n    \"\"\"Open the TAR archive at archive_path and extract every entry into the existing\n    directory dest_dir, preserving the directory structure stored in the archive.\n    \"\"\"\n    if not os.path.isdir(dest_dir):\n        raise NotADirectoryError(f\"Destination is not an existing directory: {dest_dir}\")\n\n    dest_root = os.path.realpath(dest_dir)\n\n    with tarfile.open(archive_path, \"r:*\") as tar:\n        members = tar.getmembers()\n        safe_members = []\n\n        for member in members:\n            name = member.name\n\n            if os.path.isabs(name) or name.startswith((\"/\", \"\\\\\")):\n                raise ValueError(f\"Absolute path in archive is not allowed: {name!r}\")\n\n            norm = os.path.normpath(name)\n            if norm == os.pardir or norm.startswith(os.pardir + os.sep):\n                raise ValueError(f\"Path traversal in archive is not allowed: {name!r}\")\n\n            target = os.path.realpath(os.path.join(dest_root, norm))\n            if not _is_within(dest_root, target):\n                raise ValueError(f\"Entry escapes destination directory: {name!r}\")\n\n            if member.isdev():\n                raise ValueError(f\"Device files are not allowed in archive: {name!r}\")\n\n            if member.issym():\n                link = member.linkname\n                if os.path.isabs(link) or link.startswith((\"/\", \"\\\\\")):\n                    raise ValueError(f\"Absolute symlink target is not allowed: {name!r} -> {link!r}\")\n                link_target = os.path.realpath(\n                    os.path.join(os.path.dirname(target), link)\n                )\n                if not _is_within(dest_root, link_target):\n                    raise ValueError(f\"Symlink escapes destination directory: {name!r} -> {link!r}\")\n\n            elif member.islnk():\n                link = member.linkname\n                if os.path.isabs(link) or link.startswith((\"/\", \"\\\\\")):\n                    raise ValueError(f\"Absolute hardlink target is not allowed: {name!r} -> {link!r}\")\n                link_target = os.path.realpath(os.path.join(dest_root, os.path.normpath(link)))\n                if not _is_within(dest_root, link_target):\n                    raise ValueError(f\"Hardlink escapes destination directory: {name!r} -> {link!r}\")\n\n            safe_members.append(member)\n\n        if hasattr(tarfile, \"data_filter\"):\n            tar.extractall(path=dest_root, members=safe_members, filter=\"data\")\n        else:\n            tar.extractall(path=dest_root, members=safe_members)\n```",
