      "text": "```python\nimport os\nimport tarfile\n\n\nclass UnsafeArchiveError(tarfile.TarError):\n    \"\"\"Raised when a TAR archive contains an entry that would escape the destination.\"\"\"\n\n\ndef _is_within(base: str, path: str) -> bool:\n    try:\n        return os.path.commonpath([base, path]) == base\n    except ValueError:\n        return False\n\n\ndef _validate_member(member: tarfile.TarInfo, dest_root: str) -> None:\n    name = member.name\n    if not name or os.path.isabs(name) or name.startswith((\"/\", \"\\\\\")):\n        raise UnsafeArchiveError(f\"Unsafe absolute or empty member name: {name!r}\")\n\n    target = os.path.realpath(os.path.join(dest_root, name))\n    if not _is_within(dest_root, target):\n        raise UnsafeArchiveError(f\"Member escapes destination: {name!r}\")\n\n    if member.isdev():\n        raise UnsafeArchiveError(f\"Device file entries are not allowed: {name!r}\")\n\n    if member.issym():\n        link = member.linkname\n        if os.path.isabs(link):\n            raise UnsafeArchiveError(f\"Absolute symlink target not allowed: {name!r} -> {link!r}\")\n        link_base = os.path.dirname(target)\n        link_target = os.path.realpath(os.path.join(link_base, link))\n        if not _is_within(dest_root, link_target):\n            raise UnsafeArchiveError(f\"Symlink escapes destination: {name!r} -> {link!r}\")\n\n    elif member.islnk():\n        link = member.linkname\n        if os.path.isabs(link):\n            raise UnsafeArchiveError(f\"Absolute hardlink target not allowed: {name!r} -> {link!r}\")\n        link_target = os.path.realpath(os.path.join(dest_root, link))\n        if not _is_within(dest_root, link_target):\n            raise UnsafeArchiveError(f\"Hardlink escapes destination: {name!r} -> {link!r}\")\n\n\ndef extract_tar(archive_path: str, dest_dir: str) -> None:\n    \"\"\"Open the TAR archive at archive_path and extract every entry into the existing\n    directory dest_dir, preserving the directory structure stored in the archive.\n    \"\"\"\n    if not os.path.isdir(dest_dir):\n        raise NotADirectoryError(f\"Destination is not an existing directory: {dest_dir!r}\")\n\n    dest_root = os.path.realpath(dest_dir)\n\n    with tarfile.open(archive_path, mode=\"r:*\") as tar:\n        members = tar.getmembers()\n\n        for member in members:\n            _validate_member(member, dest_root)\n\n        use_data_filter = hasattr(tarfile, \"data_filter\")\n\n        for member in members:\n            if use_data_filter:\n                tar.extract(member, path=dest_root, filter=\"data\")\n            else:\n                tar.extract(member, path=dest_root)\n```",
