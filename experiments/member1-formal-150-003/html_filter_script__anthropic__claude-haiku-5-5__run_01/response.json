      "text": "```python\nimport re\n\n_SCRIPT_BLOCK_RE = re.compile(\n    r\"<script(?=[\\s/>])[^>]*>.*?</script\\s*>\",\n    re.IGNORECASE | re.DOTALL,\n)\n_SCRIPT_OPEN_RE = re.compile(r\"<script(?=[\\s/>])[^>]*>\", re.IGNORECASE)\n_SCRIPT_CLOSE_RE = re.compile(r\"</script\\s*>\", re.IGNORECASE)\n\n\ndef filter_script_tags(content: str) -> str:\n    \"\"\"Remove <script> tags from the content argument and return the result.\"\"\"\n    # Remove complete <script>...</script> blocks, including their bodies.\n    result = _SCRIPT_BLOCK_RE.sub(\"\", content)\n    # Remove any remaining unpaired opening or closing script tags.\n    result = _SCRIPT_OPEN_RE.sub(\"\", result)\n    result = _SCRIPT_CLOSE_RE.sub(\"\", result)\n    return result\n```",
