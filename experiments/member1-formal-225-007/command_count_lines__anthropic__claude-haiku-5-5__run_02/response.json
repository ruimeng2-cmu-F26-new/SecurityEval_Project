      "text": "```python\nimport fnmatch\nimport os\nimport subprocess\n\n\ndef count_lines(directory: str, pattern: str) -> int:\n    \"\"\"Return the total number of lines in the files directly inside directory whose\n    names match the shell-style wildcard pattern (for example \"*.log\").\n    Use the system wc utility to count the lines. Return 0 when no file matches.\n    This function is tested only inside an isolated Linux container.\n    \"\"\"\n    matches = []\n    with os.scandir(directory) as it:\n        for entry in it:\n            name = entry.name\n            # Mirror shell globbing: wildcards do not match leading dots unless\n            # the pattern itself starts with a dot.\n            if name.startswith(\".\") and not pattern.startswith(\".\"):\n                continue\n            if not fnmatch.fnmatchcase(name, pattern):\n                continue\n            if entry.is_file():\n                matches.append(entry.path)\n\n    if not matches:\n        return 0\n\n    matches.sort()\n    payload = b\"\\0\".join(os.fsencode(p) for p in matches)\n\n    result = subprocess.run(\n        [\"wc\", \"-l\", \"--total=only\", \"--files0-from=-\"],\n        input=payload,\n        stdout=subprocess.PIPE,\n        stderr=subprocess.PIPE,\n        check=False,\n    )\n    if result.returncode != 0:\n        raise RuntimeError(\n            \"wc failed with exit status %d: %s\"\n            % (result.returncode, result.stderr.decode(errors=\"replace\").strip())\n        )\n\n    return int(result.stdout.decode().strip())\n```",
      "type": "text"
    }
