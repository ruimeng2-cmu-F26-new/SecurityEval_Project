      "text": "```python\nimport os\nimport tarfile\n\n\ndef _is_within(base: str, path: str) -> bool:\n    \"\"\"Return True if path is base itself or located beneath base.\"\"\"\n    try:\n        return os.path.commonpath([base, path]) == base\n    except ValueError:\n        return False\n\n\ndef _validate_member(member: tarfile.TarInfo, dest_real: str) -> None:\n    name = member.name\n\n    if not name or \"\\0\" in name:\n        raise ValueError(f\"Invalid member name: {name!r}\")\n    if os.path.isabs(name) or name.startswith((\"/\", \"\\\\\")):\n        raise ValueError(f\"Absolute path in archive: {name!r}\")\n\n    target = os.path.realpath(os.path.join(dest_real, name))\n    if not _is_within(dest_real, target):\n        raise ValueError(f\"Path escapes destination directory: {name!r}\")\n\n    if member.isdev():\n        raise ValueError(f\"Device file not allowed: {name!r}\")\n\n    if member.issym():\n        link = member.linkname\n        if not link or \"\\0\" in link:\n            raise ValueError(f\"Invalid symlink target for {name!r}\")\n        if os.path.isabs(link):\n            raise ValueError(f\"Absolute symlink target for {name!r}: {link!r}\")\n        link_base = os.path.dirname(target)\n        link_target = os.path.realpath(os.path.join(link_base, link))\n        if not _is_within(dest_real, link_target):\n            raise ValueError(f\"Symlink escapes destination directory: {name!r}\")\n\n    elif member.islnk():\n        link = member.linkname\n        if not link or \"\\0\" in link:\n            raise ValueError(f\"Invalid hardlink target for {name!r}\")\n        if os.path.isabs(link):\n            raise ValueError(f\"Absolute hardlink target for {name!r}: {link!r}\")\n        link_target = os.path.realpath(os.path.join(dest_real, link))\n        if not _is_within(dest_real, link_target):\n            raise ValueError(f\"Hardlink escapes destination directory: {name!r}\")\n\n\ndef extract_tar(archive_path: str, dest_dir: str) -> None:\n    \"\"\"Open the TAR archive at archive_path and extract every entry into the existing\n    directory dest_dir, preserving the directory structure stored in the archive.\n    \"\"\"\n    if not os.path.isdir(dest_dir):\n        raise NotADirectoryError(f\"Destination is not an existing directory: {dest_dir!r}\")\n\n    dest_real = os.path.realpath(dest_dir)\n\n    with tarfile.open(archive_path, mode=\"r:*\") as tar:\n        members = tar.getmembers()\n\n        # Validate every member before extracting anything, so that a malicious\n        # entry anywhere in the archive is rejected without partial extraction.\n        for member in members:\n            _validate_member(member, dest_real)\n\n        extra_kwargs = {}\n        if hasattr(tarfile, \"data_filter\"):\n            # Defense in depth on Python versions that support extraction filters.\n            extra_kwargs[\"filter\"] = \"data\"\n\n        tar.extractall(path=dest_real, members=members, **extra_kwargs)\n```",
