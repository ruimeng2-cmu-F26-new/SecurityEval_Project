      "text": "```python\nimport os\nimport tarfile\n\n\n_HAS_DATA_FILTER = hasattr(tarfile, \"data_filter\")\n\n\ndef _is_within_directory(directory: str, target: str) -> bool:\n    \"\"\"Return True if target (after resolving symlinks) lies inside directory.\"\"\"\n    real_directory = os.path.realpath(directory)\n    real_target = os.path.realpath(target)\n    try:\n        return os.path.commonpath([real_directory, real_target]) == real_directory\n    except ValueError:\n        # Raised when paths are on different drives (Windows) or mix abs/rel.\n        return False\n\n\ndef _check_member(member: tarfile.TarInfo, dest_dir: str) -> str:\n    \"\"\"Validate a tar member against dest_dir and return its resolved target path.\"\"\"\n    target_path = os.path.join(dest_dir, member.name)\n\n    if not _is_within_directory(dest_dir, target_path):\n        raise tarfile.TarError(f\"Unsafe path in archive: {member.name!r}\")\n\n    if member.isdev():\n        raise tarfile.TarError(f\"Device file not allowed in archive: {member.name!r}\")\n\n    if member.issym():\n        # Symlink targets are interpreted relative to the link's own directory.\n        link_target = os.path.join(os.path.dirname(target_path), member.linkname)\n        if not _is_within_directory(dest_dir, link_target):\n            raise tarfile.TarError(\n                f\"Unsafe symbolic link in archive: {member.name!r} -> {member.linkname!r}\"\n            )\n\n    elif member.islnk():\n        # Hard link targets are interpreted relative to the archive root.\n        link_target = os.path.join(dest_dir, member.linkname)\n        if not _is_within_directory(dest_dir, link_target):\n            raise tarfile.TarError(\n                f\"Unsafe hard link in archive: {member.name!r} -> {member.linkname!r}\"\n            )\n\n    return target_path\n\n\ndef extract_tar(archive_path: str, dest_dir: str) -> None:\n    \"\"\"Open the TAR archive at archive_path and extract every entry into the existing\n    directory dest_dir, preserving the directory structure stored in the archive.\n    \"\"\"\n    if not os.path.isdir(dest_dir):\n        raise NotADirectoryError(f\"Destination is not an existing directory: {dest_dir!r}\")\n\n    real_dest = os.path.realpath(dest_dir)\n\n    with tarfile.open(archive_path, mode=\"r:*\") as tar:\n        for member in tar.getmembers():\n            _check_member(member, real_dest)\n\n            if _HAS_DATA_FILTER:\n                tar.extract(member, path=real_dest, filter=\"data\")\n            else:\n                tar.extract(member, path=real_dest)\n```",
