      "text": "```python\nimport os\nimport tarfile\n\n\ndef _is_within(base: str, path: str) -> bool:\n    try:\n        return os.path.commonpath([base, path]) == base\n    except ValueError:\n        return False\n\n\ndef _check_member(member: tarfile.TarInfo, dest_abs: str) -> None:\n    name = member.name\n    if not name or os.path.isabs(name) or name.startswith((\"/\", \"\\\\\")):\n        raise ValueError(f\"Unsafe absolute path in archive: {name!r}\")\n\n    target = os.path.realpath(os.path.join(dest_abs, name))\n    if not _is_within(dest_abs, target):\n        raise ValueError(f\"Archive entry escapes destination: {name!r}\")\n\n    if member.isdev():\n        raise ValueError(f\"Device files are not extracted: {name!r}\")\n\n    if member.issym():\n        linkname = member.linkname\n        if os.path.isabs(linkname):\n            link_target = linkname\n        else:\n            link_target = os.path.join(os.path.dirname(target), linkname)\n        resolved = os.path.realpath(link_target)\n        if not _is_within(dest_abs, resolved):\n            raise ValueError(\n                f\"Symbolic link escapes destination: {name!r} -> {linkname!r}\"\n            )\n\n    elif member.islnk():\n        linkname = member.linkname\n        if not linkname or os.path.isabs(linkname):\n            raise ValueError(f\"Unsafe hard link target: {linkname!r}\")\n        link_target = os.path.realpath(os.path.join(dest_abs, linkname))\n        if not _is_within(dest_abs, link_target):\n            raise ValueError(\n                f\"Hard link escapes destination: {name!r} -> {linkname!r}\"\n            )\n\n\ndef extract_tar(archive_path: str, dest_dir: str) -> None:\n    \"\"\"Open the TAR archive at archive_path and extract every entry into the existing\n    directory dest_dir, preserving the directory structure stored in the archive.\n    \"\"\"\n    if not os.path.isdir(dest_dir):\n        raise NotADirectoryError(f\"Destination directory does not exist: {dest_dir!r}\")\n\n    dest_abs = os.path.realpath(dest_dir)\n\n    with tarfile.open(archive_path, mode=\"r:*\") as tar:\n        # Validate and extract sequentially so that each check reflects the\n        # filesystem state produced by previously extracted entries.\n        for member in tar:\n            _check_member(member, dest_abs)\n            tar.extract(member, path=dest_abs)\n```",
