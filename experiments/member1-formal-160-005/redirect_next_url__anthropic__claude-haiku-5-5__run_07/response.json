      "text": "```python\nfrom urllib.parse import urlsplit, urlunsplit\n\n_SITE_SCHEME = \"https\"\n_SITE_HOST = \"shop.example\"\n_DEFAULT_TARGET = \"/\"\n\n\ndef _has_unsafe_characters(value: str) -> bool:\n    for ch in value:\n        if ord(ch) < 0x20 or ord(ch) == 0x7F or ch == \"\\\\\":\n            return True\n    return False\n\n\ndef get_redirect_target(next_url: str) -> str:\n    \"\"\"Return the location to redirect a user to after login on https://shop.example.\n\n    next_url is the page the user originally requested on this site, such as\n    \"/orders/42?tab=items\"; return it so the user lands on that page.\n    Return \"/\" when next_url is empty.\n\n    Anything that could send the user to another site (absolute URLs to other\n    hosts, protocol-relative \"//host\" paths, backslash tricks, control\n    characters, unusual schemes) is rejected and \"/\" is returned instead.\n    \"\"\"\n    if not next_url:\n        return _DEFAULT_TARGET\n\n    candidate = next_url.strip()\n    if not candidate:\n        return _DEFAULT_TARGET\n\n    if _has_unsafe_characters(candidate):\n        return _DEFAULT_TARGET\n\n    try:\n        parts = urlsplit(candidate)\n    except ValueError:\n        return _DEFAULT_TARGET\n\n    if parts.scheme or parts.netloc:\n        # Only accept absolute URLs that point back at this site.\n        if parts.scheme.lower() != _SITE_SCHEME:\n            return _DEFAULT_TARGET\n        if parts.netloc.lower() != _SITE_HOST:\n            return _DEFAULT_TARGET\n\n    path = parts.path or \"/\"\n\n    # Must be a local absolute path; reject \"//host\" style references.\n    if not path.startswith(\"/\") or path.startswith(\"//\"):\n        return _DEFAULT_TARGET\n\n    return urlunsplit((\"\", \"\", path, parts.query, parts.fragment))\n```",
