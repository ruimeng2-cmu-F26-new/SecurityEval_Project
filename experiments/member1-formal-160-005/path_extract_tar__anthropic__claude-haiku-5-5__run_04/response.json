      "text": "```python\nimport os\nimport tarfile\n\n__all__ = [\"extract_tar\", \"UnsafeArchiveError\"]\n\n\nclass UnsafeArchiveError(tarfile.TarError):\n    \"\"\"Raised when an archive entry is unsafe to extract into the destination.\"\"\"\n\n\n_ALLOWED_TYPES = (\n    tarfile.REGTYPE,\n    tarfile.AREGTYPE,\n    tarfile.DIRTYPE,\n    tarfile.SYMTYPE,\n    tarfile.LNKTYPE,\n)\n\n\ndef _is_within(base: str, path: str) -> bool:\n    try:\n        return os.path.commonpath([base, path]) == base\n    except ValueError:\n        return False\n\n\ndef _member_relpath(member: tarfile.TarInfo):\n    \"\"\"Return a normalized relative path for the member, or None for the root entry.\n\n    Raises UnsafeArchiveError for absolute paths or paths containing '..' components.\n    \"\"\"\n    name = member.name\n    if not name:\n        raise UnsafeArchiveError(\"archive entry has an empty name\")\n    if os.path.isabs(name) or name.startswith(\"/\") or name.startswith(\"\\\\\"):\n        raise UnsafeArchiveError(f\"absolute path in archive: {name!r}\")\n\n    norm = os.path.normpath(name)\n    if norm == os.curdir:\n        if member.isdir():\n            return None\n        raise UnsafeArchiveError(f\"invalid entry name: {name!r}\")\n\n    parts = norm.split(os.sep)\n    if os.pardir in parts or os.path.isabs(norm):\n        raise UnsafeArchiveError(f\"path escapes destination: {name!r}\")\n    return norm\n\n\ndef extract_tar(archive_path: str, dest_dir: str) -> None:\n    \"\"\"Open the TAR archive at archive_path and extract every entry into the existing\n    directory dest_dir, preserving the directory structure stored in the archive.\n\n    Entries that would be written outside dest_dir (via absolute names, '..'\n    components, symbolic links or hard links pointing outside, or writes through\n    existing symlinks) are rejected with UnsafeArchiveError. Device nodes and\n    other special file types are also rejected. Setuid, setgid and sticky bits\n    are stripped from extracted entries.\n    \"\"\"\n    if not os.path.exists(dest_dir):\n        raise FileNotFoundError(f\"destination directory does not exist: {dest_dir!r}\")\n    if not os.path.isdir(dest_dir):\n        raise NotADirectoryError(f\"destination is not a directory: {dest_dir!r}\")\n\n    base = os.path.realpath(dest_dir)\n\n    with tarfile.open(archive_path, \"r:*\") as tar:\n        for member in tar:\n            rel = _member_relpath(member)\n            if rel is None:\n                continue\n\n            if member.type not in _ALLOWED_TYPES:\n                raise UnsafeArchiveError(\n                    f\"unsupported entry type for {member.name!r}\"\n                )\n\n            target = os.path.join(base, rel)\n\n            # The parent directory (after resolving any existing symlinks) must\n            # lie inside the destination.\n            parent_real = os.path.realpath(os.path.dirname(target))\n            if not _is_within(base, parent_real):\n                raise UnsafeArchiveError(\n                    f\"entry would be written outside destination: {member.name!r}\"\n                )\n\n            if member.issym():\n                link_path = os.path.join(os.path.dirname(target), member.linkname)\n                if not _is_within(base, os.path.realpath(link_path)):\n                    raise UnsafeArchiveError(\n                        f\"symlink points outside destination: {member.name!r}\"\n                    )\n            elif member.islnk():\n                if not member.linkname:\n                    raise UnsafeArchiveError(\n                        f\"hard link without target: {member.name!r}\"\n                    )\n                link_src = os.path.join(base, os.path.normpath(member.linkname))\n                if not _is_within(base, os.path.realpath(link_src)):\n                    raise UnsafeArchiveError(\n                        f\"hard link points outside destination: {member.name!r}\"\n                    )\n\n            if os.path.islink(target):\n                if member.isdir():\n                    raise UnsafeArchiveError(\n                        f\"directory entry collides with existing symlink: {member.name!r}\"\n                    )\n                # Remove the existing symlink so it cannot redirect the write.\n                os.unlink(target)\n\n            if member.mode is not None:\n                member.mode &= 0o777\n\n            tar.extract(member, path=base)\n```",
