      "text": "```python\nimport os\nimport tarfile\n\n\ndef _is_within(base: str, path: str) -> bool:\n    \"\"\"Return True if path is base or located beneath base (both must be absolute, real paths).\"\"\"\n    try:\n        return os.path.commonpath([base, path]) == base\n    except ValueError:\n        # Raised on Windows when paths are on different drives.\n        return False\n\n\ndef _validate_member(member: tarfile.TarInfo, dest_root: str) -> None:\n    \"\"\"Raise ValueError if the member could escape dest_root or is otherwise unsafe.\n\n    The check is performed immediately before each member is extracted so that\n    previously extracted symlinks within dest_root are taken into account.\n    \"\"\"\n    name = member.name\n\n    if os.path.isabs(name) or name.startswith((\"/\", \"\\\\\")):\n        raise ValueError(f\"Unsafe absolute path in archive: {name!r}\")\n\n    normalized = os.path.normpath(name)\n    if normalized == os.pardir or normalized.startswith(os.pardir + os.sep):\n        raise ValueError(f\"Path traversal in archive member: {name!r}\")\n\n    target = os.path.realpath(os.path.join(dest_root, normalized))\n    if not _is_within(dest_root, target):\n        raise ValueError(f\"Archive member escapes destination: {name!r}\")\n    if target == dest_root and not member.isdir():\n        raise ValueError(f\"Archive member would replace destination directory: {name!r}\")\n\n    if member.isdev():\n        raise ValueError(f\"Device or FIFO entries are not allowed: {name!r}\")\n\n    if member.issym():\n        link = member.linkname\n        if os.path.isabs(link) or link.startswith((\"/\", \"\\\\\")):\n            raise ValueError(f\"Symbolic link with absolute target: {name!r} -> {link!r}\")\n        resolved = os.path.realpath(os.path.join(os.path.dirname(target), link))\n        if not _is_within(dest_root, resolved):\n            raise ValueError(f\"Symbolic link escapes destination: {name!r} -> {link!r}\")\n\n    elif member.islnk():\n        link = member.linkname\n        if os.path.isabs(link) or link.startswith((\"/\", \"\\\\\")):\n            raise ValueError(f\"Hard link with absolute target: {name!r} -> {link!r}\")\n        link_norm = os.path.normpath(link)\n        if link_norm == os.pardir or link_norm.startswith(os.pardir + os.sep):\n            raise ValueError(f\"Hard link escapes destination: {name!r} -> {link!r}\")\n        resolved = os.path.realpath(os.path.join(dest_root, link_norm))\n        if not _is_within(dest_root, resolved):\n            raise ValueError(f\"Hard link escapes destination: {name!r} -> {link!r}\")\n\n\ndef extract_tar(archive_path: str, dest_dir: str) -> None:\n    \"\"\"Open the TAR archive at archive_path and extract every entry into the existing\n    directory dest_dir, preserving the directory structure stored in the archive.\n    \"\"\"\n    if not os.path.isdir(dest_dir):\n        raise NotADirectoryError(f\"Destination directory does not exist: {dest_dir!r}\")\n\n    dest_root = os.path.realpath(dest_dir)\n    use_filter = hasattr(tarfile, \"data_filter\")\n\n    with tarfile.open(archive_path, mode=\"r:*\") as tar:\n        for member in tar.getmembers():\n            # Validate right before extraction so that links created earlier in\n            # the archive are considered when checking later members.\n            _validate_member(member, dest_root)\n            if use_filter:\n                tar.extract(member, path=dest_root, filter=\"data\")\n            else:\n                tar.extract(member, path=dest_root)\n```",
