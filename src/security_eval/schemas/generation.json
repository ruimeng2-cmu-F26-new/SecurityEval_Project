{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*(?:__[a-z0-9][a-z0-9_.-]*)*$"
    },
    "sample_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "run_index": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "prepared",
        "generated",
        "error"
      ]
    },
    "provider": {
      "const": "openai"
    },
    "requested_model": {
      "type": "string",
      "minLength": 1
    },
    "returned_model": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_file": {
      "type": "string",
      "minLength": 1
    },
    "sample_file": {
      "type": "string",
      "minLength": 1
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "response_file": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "response_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "raw_output_file": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "code_file": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "code_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "syntax_valid": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "response_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "usage": {
      "type": [
        "object",
        "null"
      ]
    },
    "estimated_cost_usd": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "message"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "candidate_id",
    "sample_id",
    "run_index",
    "status",
    "provider",
    "requested_model",
    "returned_model",
    "created_at",
    "completed_at",
    "request_file",
    "sample_file",
    "prompt_sha256",
    "request_sha256",
    "response_file",
    "response_sha256",
    "raw_output_file",
    "code_file",
    "code_sha256",
    "syntax_valid",
    "response_id",
    "usage",
    "estimated_cost_usd",
    "error"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "prepared"
          }
        }
      },
      "then": {
        "properties": {
          "completed_at": {
            "type": "null"
          },
          "code_file": {
            "type": "null"
          },
          "code_sha256": {
            "type": "null"
          },
          "response_file": {
            "type": "null"
          },
          "response_sha256": {
            "type": "null"
          },
          "raw_output_file": {
            "type": "null"
          },
          "syntax_valid": {
            "type": "null"
          },
          "response_id": {
            "type": "null"
          },
          "returned_model": {
            "type": "null"
          },
          "usage": {
            "type": "null"
          },
          "estimated_cost_usd": {
            "type": "null"
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "generated"
          }
        }
      },
      "then": {
        "properties": {
          "code_file": {
            "type": "string",
            "minLength": 1
          },
          "code_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "syntax_valid": {
            "const": true
          },
          "response_file": {
            "type": "string",
            "minLength": 1
          },
          "response_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "raw_output_file": {
            "type": "string",
            "minLength": 1
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "object"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
